{
  "name": "@uu/core",
  "version": "0.2.1",
  "private": true,
  "type": "module",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "exports": {
    ".": {
      "types": "./build/src/index.d.ts",
      "default": "./build/src/index.js"
    },
    "./protocol": {
      "types": "./build/src/protocol.d.ts",
      "default": "./build/src/protocol.js"
    },
    "./context": {
      "types": "./build/src/context/index.d.ts",
      "default": "./build/src/context/index.js"
    }
  },
  "files": [
    "build/src",
    "README.md",
    "docs/PROTOCOL.md",
    "docs/CONTEXT.md"
  ],
  "types": "./build/src/index.d.ts",
  "typesVersions": {
    "*": {
      "context": ["build/src/context/index.d.ts"],
      "protocol": ["build/src/protocol.d.ts"]
    }
  },
  "scripts": {
    "build": "node tools/check-node.mjs && tsc -p tsconfig.json",
    "typecheck": "node tools/check-node.mjs && tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test --test-concurrency=1 tests/*.test.mjs",
    "check:boundaries": "node tools/check-boundaries.mjs",
    "check:package": "node tools/check-package.mjs",
    "check:distribution": "node tools/check-distribution.mjs",
    "verify": "npm run typecheck && npm run check:distribution && npm test && npm run check:boundaries && npm run check:package",
    "uu": "node bin/uu.mjs"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.9.3"
  }
}
